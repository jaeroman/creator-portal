# Copy to .env.local and fill in from your Neon project (Vercel Storage tab,
# or `vercel env pull .env.local`). Both point at the same database.

# Pooled connection. Used by the app at runtime through the driver adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Unpooled connection. Used by the Prisma CLI for migrations, which cannot run
# through the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
